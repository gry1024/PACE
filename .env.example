# 中文说明：仅在没有.env时复制此示例；保留已有凭据，不覆盖用户配置。
# 本地数据库连接串由开发脚本写入.env.local；进程环境优先于文件。
# Copy to .env only if it does not already exist. Never commit real credentials.
# 运行环境标记，不是身份认证或就绪开关。
APP_ENV=development
# scripts/dev_db.sh writes a generated local DATABASE_URL into .env.local.
# For an existing PostgreSQL instance:
# DATABASE_URL=postgresql://pace:replace-me@127.0.0.1:54329/pace


# 官方Jev Key名称优先；兼容已有.env中的JEV_API_KEY，空值会忽略。
TYPESAFE_API_KEY=
# 固定选择模型基线；效果 /用量需另行评测，不能默认追latest。
JEV_MODEL=jev-1.13.0

# 服务端兼容LLM凭据，仅Adapter可读取，禁止提交真实值。
OPENAI_API_KEY=
# 兼容服务地址；用于已授权文件的 Ontology 提取。
OPENAI_BASE_URL=https://api.openai.com/v1
# 显式指定模型；没有model不能只凭Key调用LLM。
OPENAI_MODEL_NAME=

# Google Web OAuth callback: PUBLIC_BASE_URL/auth/google/callback。
# 不覆盖已有 .env；仅把所需字段添加到私有配置。只接受个人 @gmail.com。
PUBLIC_BASE_URL=http://127.0.0.1:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Fernet key：私密生成并长期保存，不能提交 / 公开；丢失无法解密已有状态。
ENCRYPTION_KEY=
# 精确 Host OAuth 回跳列表（JSON）；生产必须使用受信任 HTTPS URI。
OAUTH_REDIRECT_ALLOWLIST=[]
OAUTH_ACCESS_SECONDS=3600
OAUTH_REFRESH_SECONDS=2592000
# capture 只私有落盘。gmail 才调用真实系统 Gmail API。
EMAIL_DELIVERY_MODE=capture
CAPTURE_DIRECTORY=.local/mail
GMAIL_SENDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Gmail refresh token 应只授予系统发件账号的 gmail.send 权限。

# Framework operational limits (not model quality thresholds).
# 单次SDK请求超时，不是整次连接总超时。
PROVIDER_TIMEOUT_SECONDS=20
# JSON输入保守预算，单位字节；不要把它当精确token数。
JEV_INPUT_BYTES=24000
# 单次Tournament同轮并发上限，尚非跨请求全局限流。
SELECTION_CONCURRENCY=4
# 任务租约期限；Worker每三分之一周期续租，过期允许恢复。
WORKER_LEASE_SECONDS=300
# 空队列休眠间隔，避免数据库忙轮询。
WORKER_POLL_SECONDS=2
CONNECT_TIMEOUT_SECONDS=60
MAX_CANDIDATES=128
ONTOLOGY_INPUT_BYTES=48000
ONTOLOGY_MAX_OUTPUT_TOKENS=800
